{
  "dataset": {
    "input_path": "video_src/camera_camera_color_image_raw.mp4",
    "start_frame": 0,
    "max_frames": 0,
    "fallback_fps": 30.0
  },
  "camera": {
    "fx": null,
    "fy": null,
    "cx": null,
    "cy": null,
    "distortion": []
  },
  "preprocess": {
    "resize_width": 0,
    "clahe": true
  },
  "features": {
    "method": "shi_tomasi_klt",
    "max_features": 200,
    "min_features": 80,
    "detect_interval": 5,
    "quality": 0.01,
    "min_distance": 30,
    "block_size": 7,
    "descriptor_ratio": 0.75
  },
  "optical_flow": {
    "window_size": 21,
    "max_level": 3,
    "max_iterations": 30,
    "epsilon": 0.01,
    "forward_backward_threshold": 0.8
  },
  "geometry": {
    "model": "auto",
    "ransac_threshold": 0.75,
    "ransac_confidence": 0.999
  },
  "odometry": {
    "enabled": true,
    "assumed_focal_scale": 1.2,
    "motion_scale": 0.05,
    "min_pose_inliers": 20,
    "pose_ransac_threshold": 1.0,
    "pose_ransac_confidence": 0.999
  },
  "imu": {
    "csv_path": null,
    "timestamp_column": "timestamp_sec",
    "gyro_columns": ["gyro_x", "gyro_y", "gyro_z"],
    "accel_columns": ["accel_x", "accel_y", "accel_z"]
  },
  "output": {
    "output_dir": "outputs",
    "write_video": true,
    "draw_rejected": false
  }
}
