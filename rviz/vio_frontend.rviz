Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Visual Odometry
      Topic:
        Value: /visual_odom
      Shape: Arrow
      Keep: 1
      Position Tolerance: 0.01
      Angle Tolerance: 0.01
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Local Path
      Topic:
        Value: /local_path
      Color: 25; 170; 255
      Line Style: Lines
      Line Width: 0.05
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Current Feature Point Cloud
      Topic:
        Value: /vins_estimator/point_cloud
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 255; 230; 80
      Alpha: 0.7
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Feature History Cloud
      Topic:
        Value: /vins_estimator/feature_history_cloud
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 90; 220; 255
      Alpha: 0.3
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Value: /vins_estimator/feature_tracks
      Name: Feature Track History
      Queue Size: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Sim Odom Reference XY
      Topic:
        Value: /sim_odom_reference_path
      Color: 255; 0; 0
      Line Style: Lines
      Line Width: 0.08
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic:
        Value: /sim_odom_reference_marker
      Name: Sim Odom Reference Marker
      Namespaces:
        sim_odom_reference: true
      Queue Size: 1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.785
      Target Frame: <Fixed Frame>
      Yaw: 0.785
