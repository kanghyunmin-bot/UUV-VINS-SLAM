Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: false
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: VINS Path
      Topic:
        Value: /vins_path_overlay
      Color: 25; 170; 255
      Line Style: Lines
      Line Width: 0.08
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: DVL Reference Path
      Topic:
        Value: /dvl_reference_path
      Color: 255; 45; 45
      Line Style: Lines
      Line Width: 0.12
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Value: /vins_path_direction_markers
      Name: VINS Direction Arrows
      Queue Size: 1
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Value: /dvl_reference_direction_markers
      Name: DVL Direction Arrows
      Queue Size: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Best Candidate Path
      Topic:
        Value: /control_best_path
      Color: 70; 255; 120
      Line Style: Lines
      Line Width: 0.1
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Feature Cloud Reference Path
      Topic:
        Value: /feature_cloud_reference_path
      Color: 255; 190; 40
      Line Style: Lines
      Line Width: 0.08
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Current Feature Point Cloud
      Topic:
        Value: /vins_estimator/point_cloud
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 255; 230; 80
      Alpha: 0.8
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Feature History Cloud
      Topic:
        Value: /vins_estimator/feature_history_cloud
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 90; 220; 255
      Alpha: 0.45
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Value: /vins_estimator/feature_tracks
      Name: Feature Track History
      Queue Size: 1
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Dense Stereo Pool Map
      Topic:
        Value: /dense_stereo_map
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 180; 255; 180
      Alpha: 0.85
      Value: false
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Fitted Pool Rectangle Path
      Topic:
        Value: /pool_rectangle_path
      Color: 255; 80; 220
      Line Style: Lines
      Line Width: 0.16
      Value: false
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Marker Topic:
        Value: /pool_rectangle_marker
      Name: Fitted Pool Rectangle Marker
      Queue Size: 1
      Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 2.3
        Y: -1.0
        Z: 0.0
      Name: Current View
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Yaw: 0.75
