Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 130; 130; 130
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 1
      Name: Axes
      Radius: 0.05
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: VINS Tracking Stereo
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vins_estimator/image_track
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 255
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.09
      Name: Raw Live VINS Path - cyan
      Pose Color: 0; 255; 255
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 80
      Enabled: false
      Head Diameter: 0.18
      Head Length: 0.14
      Length: 0.22
      Line Style: Lines
      Line Width: 0.07
      Name: TF Localized VINS Path - green
      Pose Color: 0; 255; 80
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /tf_localized_path
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 40; 255; 80
      Enabled: true
      Head Diameter: 0.14
      Head Length: 0.10
      Length: 0.18
      Line Style: Lines
      Line Width: 0.08
      Name: EKF Localization Path - green
      Pose Color: 40; 255; 80
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /localization/path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 220; 0
      Enabled: false
      Head Diameter: 0.14
      Head Length: 0.10
      Length: 0.18
      Line Style: Lines
      Line Width: 0.08
      Name: EKF Localized Path - yellow
      Pose Color: 255; 220; 0
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /filtered_path
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 255
      Enabled: false
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.10
      Name: Recent Finalturn VINS Path - disabled
      Pose Color: 0; 255; 255
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vins_path_overlay
      Value: false
    - Angle Tolerance: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 0; 190; 255
      Enabled: true
      Head Length: 0.08
      Head Radius: 0.035
      Keep: 10
      Name: Raw Live VINS Odometry Direction - cyan arrows
      Position Tolerance: 0.45
      Shape: Arrow
      Shaft Length: 0.18
      Shaft Radius: 0.014
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry
      Value: true
    - Angle Tolerance: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 0; 255; 80
      Enabled: false
      Head Length: 0.055
      Head Radius: 0.025
      Keep: 12
      Name: TF Localized Odometry Direction - green arrows
      Position Tolerance: 0.35
      Shape: Arrow
      Shaft Length: 0.12
      Shaft Radius: 0.010
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /tf_localized_odometry
      Value: false
    - Angle Tolerance: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 40; 255; 80
      Enabled: true
      Head Length: 0.055
      Head Radius: 0.025
      Keep: 12
      Name: EKF Localization Odometry Direction - green arrows
      Position Tolerance: 0.35
      Shape: Arrow
      Shaft Length: 0.12
      Shaft Radius: 0.010
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Value: true
    - Angle Tolerance: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 255; 220; 0
      Enabled: false
      Head Length: 0.05
      Head Radius: 0.022
      Keep: 12
      Name: EKF Localized Odometry Direction - yellow arrows
      Position Tolerance: 0.35
      Shape: Arrow
      Shaft Length: 0.11
      Shaft Radius: 0.009
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Value: false
    - Angle Tolerance: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 0; 190; 255
      Enabled: false
      Head Length: 0.08
      Head Radius: 0.035
      Keep: 10
      Name: Recent Finalturn Odometry Direction - disabled
      Position Tolerance: 0.45
      Shape: Arrow
      Shaft Length: 0.18
      Shaft Radius: 0.014
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /feature_cloud_reference_odom
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 45; 45
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: DVL Reference Path - red
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dvl_reference_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: DVL Direction Arrows
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dvl_reference_direction_markers
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud
      Color: 255; 0; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Filtered Live VINS Stereo Feature Cloud - magenta
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.015
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /point_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 255; 180; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Filtered VINS Feature Scan Debug - orange
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan_world_debug
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.85
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 220; 60
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Recent Stable VINS Feature Cloud - disabled
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vins_estimator/point_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 2.4
        Y: -1.6
        Z: 0.0
      Name: Current View
      Pitch: 1.05
      Target Frame: <Fixed Frame>
      Yaw: 0.72
